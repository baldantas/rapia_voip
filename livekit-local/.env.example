# =============================================================================
# Copie para .env:   Copy-Item .env.example .env
# Depois:            .\scripts\render-config.ps1 -GenKeys
# NUNCA versione o .env (contém segredos).
# =============================================================================

LIVEKIT_VERSION=latest
SIP_VERSION=latest
ASTERISK_VERSION=latest

# --- Rede
# IP público fixo da sua Internet (anunciado no SIP/SDP pelo Asterisk)
PUBLIC_IP=
# IP da sua máquina na rede local (fixe por reserva DHCP no roteador)
LAN_IP=192.168.0.21
# Faixa da sua rede local (para o Asterisk não aplicar NAT dentro dela)
LAN_CIDR=192.168.0.0/24

# --- Conta SIP do provedor (registro com login e senha)
SIP_PROVIDER_HOST=sip.provedor.com.br
SIP_PROVIDER_PORT=5060
# Usuário/ramal da conta, SEM o domínio (ex.: 8431901994, não 8431901994@provedor)
SIP_USERNAME=
# Usuário de autenticação, se for diferente do SIP_USERNAME (senão repita)
SIP_AUTH_USERNAME=
SIP_PASSWORD=
# Intervalo de renovação do registro, em segundos (mantém o NAT aberto)
SIP_REG_EXPIRY=120

# --- Número (DID) da central, em E.164. É o "numbers" do trunk no LiveKit.
SIP_DID=+558431901994
# Prefixo aplicado ao número nas chamadas de saída, já sem o "+".
# Exemplos: vazio = "5511999999999" | "0" = "05511999999999" | "+" = E.164
SIP_OUT_PREFIX=

# --- Portas expostas (encaminhar as MESMAS no roteador)
SIP_PORT=5060
AST_RTP_START=20000
AST_RTP_END=20099

# --- Credenciais da API LiveKit (geradas pelo -GenKeys se vazias)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Redis interno (não publicado)
REDIS_PASSWORD=

# --- LiveKit SIP (interno; conversa apenas com o Asterisk)
SIP_RTP_START=10000
SIP_RTP_END=10099
SIP_MAX_ACTIVE_CALLS=10

# --- Webhook do LiveKit -> Laravel (só preencha depois que a rota existir, no M0)
# Local: URL FIXA do backend de desenvolvimento, a mesma do loadConfig() do sysweb.
# O container resolve api.ipsys pelo extra_hosts do docker-compose.
#   LIVEKIT_WEBHOOK_URL=http://api.ipsys/api/voice/livekit/webhook
# Produção (host único, o tenant vem do nome da sala; ver TODO seção 7.2):
#   LIVEKIT_WEBHOOK_URL=https://voice.api.rapia.app/api/voice/livekit/webhook
LIVEKIT_WEBHOOK_URL=

# --- AMI (Asterisk Manager Interface) - o Laravel usa pra recarregar a config
# de ramais sem reiniciar o container (M2.5). Só é publicado em 127.0.0.1
# (nunca 0.0.0.0) - diferente das portas SIP, não tem motivo pra existir na
# internet. Secret gerado pelo -GenKeys se vazio.
AMI_PORT=5038
AMI_USER=rapia
AMI_SECRET=

# debug ajuda a ver INVITE/SDP durante os primeiros testes
LOG_LEVEL=debug

# --- URA de entrada (M2.5). 0 = entrada direto pra IA (padrão, estado que
# funciona); 1 = passa pela URA. Pausada por um problema de mídia com o
# provedor em ligação real - ver TODO, fim do bloco M2.5.
URA_ATIVA=0
