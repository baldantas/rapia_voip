; Gerado por scripts/render-config.ps1 - edite o template, não este arquivo.
; AMI (Asterisk Manager Interface) - M2.5: é como o Laravel manda o Asterisk
; recarregar a config de ramais (pjsip reload) sem reiniciar o container.
; A porta só é publicada em 127.0.0.1 pelo docker-compose (nunca 0.0.0.0) -
; por isso o "permit" aqui pode ser generoso dentro da rede docker/loopback,
; sem risco de exposição externa como as portas SIP têm.
[general]
enabled = yes
port = 5038
bindaddr = 0.0.0.0
displayconnects = no

[${AMI_USER}]
secret = ${AMI_SECRET}
deny = 0.0.0.0/0.0.0.0
permit = 172.30.0.0/255.255.255.0
permit = 127.0.0.1/255.255.255.255
read = system,call,command,reporting
write = system,call,command,reload
