# Copie para .env:  Copy-Item .env.example .env
# NUNCA versione o .env.

# --- LiveKit local (mesmos valores do voip\livekit-local\.env)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini Live (chave do Google AI Studio: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelos Live disponíveis (set/2026):
#   gemini-3.8-live                    -> padrão, menor latência
#   gemini-3.8-live-extended-thinking  -> mais raciocínio, resposta mais lenta
GEMINI_MODEL=gemini-3.8-live
# Voz do modelo (ex.: Kore, Puck, Charon, Aoede). Teste qual soa melhor em pt-BR.
GEMINI_VOICE=Kore
GEMINI_TEMPERATURE=0.6
# Idioma da fala e do reconhecimento (fallback; o runtime do RAPIA manda voice_agents.language)
GEMINI_LANGUAGE=pt-BR

# --- Identidade do agente
# Precisa ser igual ao agent_name da dispatch rule do LiveKit
AGENT_NAME=rapia-voice
# Tenant (subdomínio) embutido no nome da sala. Local: api. Só letras e números.
TENANT=api

# --- RAPIA (M1: agent.py busca prompt/tools daqui a cada chamada, em vez de
# usar prompt.md/GEMINI_* fixos — essas chaves acima viram só fallback)
# URL fixa em dev (loadConfig() do sysweb); em produção vira template com {tenant}
RAPIA_API_URL=http://api.ipsys/api
# Token do worker (sys_parametros: modulo VOICE, param VOICE_WORKER_TOKEN)
RAPIA_API_TOKEN=
# voice_agents.id a carregar quando o job não traz agent_id nos metadados do
# dispatch (ex.: `agent.py console`)
VOICE_AGENT_ID=1

# Sensibilidade de início/fim de fala do Gemini Live (barge-in), HIGH ou LOW.
# Ver agent.py::realtime_input_config — calibrar com ligação real de telefone.
VOICE_START_SENSITIVITY=HIGH
VOICE_END_SENSITIVITY=HIGH

# M5.1: dica de idioma e vocabulario da transcricao de entrada (sem variavel = comportamento anterior)
#VOICE_TRANSCRICAO_IDIOMAS=pt-BR
#VOICE_TRANSCRICAO_VOCAB=consulta|exame|data de nascimento
# Testar o limite de duracao da ligacao (so homologacao)
#VOICE_MAX_CALL_SECONDS_FORCAR=70
