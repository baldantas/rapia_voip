# Copie para .env e preencha (cp .env.example .env). Nunca versionar o .env.

# Elastic IP da EC2 (IP público anunciado no SIP/SDP)
PUBLIC_IP=
# CIDR da VPC (destinos "locais", sem reescrita de IP). Padrão da VPC default.
VPC_CIDR=172.31.0.0/16

# Conta SIP do provedor - mesmos valores de voip/livekit-local/.env
SIP_PROVIDER_HOST=voz.sobreip.com.br
SIP_PROVIDER_PORT=5060
SIP_USERNAME=8431901994
SIP_AUTH_USERNAME=8431901994
SIP_PASSWORD=
SIP_REG_EXPIRY=120

# Mesma imagem testada localmente (andrius/asterisk:latest = Asterisk 22.10.1 em 24/09/2026)
ASTERISK_VERSION=latest
