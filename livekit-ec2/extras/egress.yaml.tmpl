# Gerado por scripts/render-config.sh (só com S3_BUCKET no .env) - edite o template, não este arquivo.
api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}
ws_url: ws://127.0.0.1:7880
insecure: true

redis:
  address: 127.0.0.1:6379
  password: ${REDIS_PASSWORD}

health_port: 8082

# Destino padrão das gravações: o Laravel não manda credencial no pedido, só o
# caminho do arquivo (voz/gravacoes/{tenant}/{yyyy}/{mm}/...). Usuário IAM
# dedicado, política restrita a s3:PutObject em ${S3_BUCKET}/voz/gravacoes/*.
# egress 1.14: o destino fica em "storage:" (com "s3:" na raiz ele ignora e tenta
# gravar no disco do container: "Local upload failed: mkdir /voz", ensaio de 26/09/2026).
storage:
  s3:
    access_key: ${S3_ACCESS_KEY}
    secret: ${S3_SECRET}
    region: ${S3_REGION}
    bucket: ${S3_BUCKET}

# t3a.medium (2 vCPU): o egress recusa gravação nova acima deste custo de CPU
cpu_cost:
  audio_room_composite_cpu_cost: 0.5
  max_cpu_utilization: 0.9

logging:
  level: ${EGRESS_LOG_LEVEL}
  json: true
