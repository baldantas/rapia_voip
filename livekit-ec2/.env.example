# =============================================================================
# Copie para .env e preencha:  cp .env.example .env
# Depois:                      ./scripts/render-config.sh --gen-keys
# NUNCA versione o .env (contém segredos).
# =============================================================================

# --- Versões das imagens (fixar depois de validar)
LIVEKIT_VERSION=latest
SIP_VERSION=latest
ASTERISK_VERSION=latest

# --- Rede
# Elastic IP (anunciado pelo Asterisk no SIP/SDP para o provedor)
PUBLIC_IP=
# IP anunciado pelo LiveKit ao navegador/worker. OpenVPN UDP: IP privado da
# instância. OpenVPN TCP: o Elastic IP (ver voip/livekit-ec2/README.md).
NODE_IP=
# CIDR da VPC (o Asterisk não aplica o IP externo dentro dela)
VPC_CIDR=172.31.0.0/16

# --- Credenciais da API LiveKit (geradas pelo --gen-keys se vazias)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Redis local (só 127.0.0.1; gerado pelo --gen-keys se vazio)
REDIS_PASSWORD=

# --- Webhook do LiveKit -> Laravel. Homologação: túnel ngrok para o sysapi do PC.
LIVEKIT_WEBHOOK_URL=https://apiflowip.ngrok.app/api/voice/livekit/webhook

# --- Base da API do RAPIA usada pela URA (CURL() do dialplan), sem "/" no fim
RAPIA_BASE_URL=https://apiflowip.ngrok.app/api
# Mesmo valor do VOICE_WORKER_TOKEN (sys_parametros) usado pelo worker
URA_API_TOKEN=
# Timeouts do CURL() da URA, em segundos. Local: 1/2. Pelo ngrok há mais latência.
URA_CURL_CONNTIMEOUT=2
URA_CURL_HTTPTIMEOUT=4
# 0 = entrada direto para a IA (padrão); 1 = passa pela URA (pedir antes de ligar)
URA_ATIVA=0

# --- Conta SIP do provedor (registro com login e senha, feito pelo Asterisk)
SIP_PROVIDER_HOST=voz.sobreip.com.br
SIP_PROVIDER_PORT=5060
# IPs de onde o provedor envia INVITEs (separados por espaço). Vão para o
# "match" do identify do endpoint provedor, junto com o SIP_PROVIDER_HOST.
SIP_PROVIDER_IN_IPS="189.113.38.59 186.209.45.20 186.209.52.214 216.10.29.131"
# Usuário/ramal da conta, SEM o domínio (ex.: 8431901994, não 8431901994@provedor)
SIP_USERNAME=8431901994
# Usuário de autenticação, se for diferente do SIP_USERNAME (senão deixe vazio)
SIP_AUTH_USERNAME=
SIP_PASSWORD=
SIP_REG_EXPIRY=120
# Número (DID) da central em E.164; é o "numbers" do trunk no LiveKit e o caller ID de saída
SIP_DID=+558431901994
# Prefixo aplicado ao número nas chamadas de saída, já sem o "+".
# Exemplos: vazio = "5511999999999" | "0" = "05511999999999" | "+" = E.164
SIP_OUT_PREFIX=

# --- Asterisk (exposto: 5060 + RTP, só para os IPs do provedor no Security Group)
SIP_PORT=5060
AST_RTP_START=20000
AST_RTP_END=20099

# --- LiveKit SIP (só loopback; nada disso vai no Security Group)
LIVEKIT_SIP_PORT=5080
SIP_RTP_START=10000
SIP_RTP_END=19999
SIP_MAX_ACTIVE_CALLS=10

# --- AMI (só 127.0.0.1; secret gerado pelo --gen-keys se vazio)
AMI_PORT=5038
AMI_USER=rapia
AMI_SECRET=

# --- Gravação (Egress, M5). Vazio = sem gravação (config/egress.yaml não é gerado).
# Usuário IAM dedicado, política só com s3:PutObject em <bucket>/voz/gravacoes/*.
# COMPOSE_PROFILES=gravacao faz o "docker compose up -d" subir também o egress.
COMPOSE_PROFILES=
EGRESS_VERSION=latest
S3_BUCKET=
S3_REGION=sa-east-1
S3_ACCESS_KEY=
S3_SECRET=
EGRESS_LOG_LEVEL=info

# debug ajuda a ver INVITE/SDP nos primeiros testes
LOG_LEVEL=debug
