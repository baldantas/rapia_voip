# Gerado por scripts/render-config.sh - edite o template, não este arquivo.
api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}
ws_url: ws://127.0.0.1:7880

redis:
  address: 127.0.0.1:6379
  password: ${REDIS_PASSWORD}

# Só o Asterisk (127.0.0.1) conversa com este serviço. Nem a 5080 nem a faixa
# RTP abaixo são liberadas no Security Group.
sip_port: ${LIVEKIT_SIP_PORT}
rtp_port: ${SIP_RTP_START}-${SIP_RTP_END}
use_external_ip: false

max_active_calls: ${SIP_MAX_ACTIVE_CALLS}

health_port: 8081

logging:
  level: ${LOG_LEVEL}
